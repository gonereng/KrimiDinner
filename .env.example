# --- KI-Anbieter ------------------------------------------------------------
# deepseek (Standard) oder gemini
LLM_PROVIDER=deepseek

# --- DeepSeek ---------------------------------------------------------------
# API-Key: https://platform.deepseek.com/api_keys (Guthaben aufladen nicht vergessen)
DEEPSEEK_API_KEY=
# Modellnamen (Stand Nov. 2026 – die alten Namen deepseek-chat/-reasoner sind abgeschaltet;
# aktuelle Liste: https://api-docs.deepseek.com/quick_start/pricing)
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
# Für den Logik-Gegencheck darf es auch das stärkere Modell sein, z. B. deepseek-v4-pro
DEEPSEEK_CHECK_MODEL=deepseek-v4-flash
# Maximale Antwortlänge in Tokens (ein ganzes Kit ist eine lange JSON-Antwort)
DEEPSEEK_MAX_TOKENS=32000
# Optional: "Thinking" (Nachdenken vor der Antwort) – enabled, disabled oder leer = Modell-Standard
DEEPSEEK_THINKING=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Google Gemini (optional) -----------------------------------------------
# Wird gebraucht, wenn LLM_PROVIDER=gemini ODER wenn Illustrationen erzeugt werden sollen
# (DeepSeek kann keine Bilder). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_CHECK_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Web-App --------------------------------------------------------------
# Passwort für die Anmeldung in der Web-Oberfläche (Pflicht!)
APP_PASSWORD=bitte-aendern
# Zufälliger langer String zum Signieren der Sitzungs-Cookies
# (z. B. erzeugen mit: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=

# --- Pfade (optional) ------------------------------------------------------
# KRIMI_OUTPUT_DIR=output
# KRIMI_CACHE_DIR=.cache
